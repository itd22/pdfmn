{
  "version": "0.2.0",
  "configurations": [


    {
      "name": "pdftui",
      "type": "python",
      "request": "launch",
      "module": "pdftui.main",
      "pythonPath": "/bin/python3",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "args": [
        "--action",
        "load_json",
        "--main-json",
        "main.json"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "pdftui (crawl to_yaml)",
      "type": "python",
      "request": "launch",
      "module": "pdftui.main",
      "pythonPath": "/bin/python3",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "args": [
        "--action",
        "crawl_to_yaml",
        "--top-dir",
        "/mnt/shared/gitlab_books"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
