{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "run_app.sh (load_json)",
      "type": "shell",
      "command": "bash",
      "args": [
        "run_app.sh",
        "--action",
        "load_json"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
